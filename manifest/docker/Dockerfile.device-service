FROM m.daocloud.io/docker.io/library/golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/device-service ./cmd/device-service

FROM m.daocloud.io/docker.io/library/alpine:3.19

RUN apk add --no-cache tzdata
ENV TZ=Asia/Shanghai

ENV WORKDIR=/app
ENV GF_GCFG_FILE=manifest/config/config.device-service.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/device-service ${WORKDIR}/device-service
COPY resource ${WORKDIR}/resource
COPY manifest/config/config.device-service.yaml ${WORKDIR}/manifest/config/config.device-service.yaml

EXPOSE 9803
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9803/api.json > /dev/null || exit 1
CMD ["./device-service"]

