FROM m.daocloud.io/docker.io/library/golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/cash-service ./cmd/cash-service

FROM m.daocloud.io/docker.io/library/alpine:3.19

RUN apk add --no-cache tzdata
ENV TZ=Asia/Shanghai

ENV WORKDIR=/app
ENV GF_GCFG_FILE=manifest/config/config.cash-service.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/cash-service ${WORKDIR}/cash-service
COPY manifest/config/config.cash-service.yaml ${WORKDIR}/manifest/config/config.cash-service.yaml

EXPOSE 9807
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9807/api.json > /dev/null || exit 1
CMD ["./cash-service"]
