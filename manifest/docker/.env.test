# =============================================================================
# 测试环境（project=go-ai-talk-test）
# 启动：docker compose --env-file manifest/docker/.env.test \
#   -f manifest/docker/docker-compose.microservices.yml \
#   -f manifest/docker/docker-compose.microservices.test.yml \
#   -f manifest/docker/docker-compose.resources.test.yml \
#   pull && up -d --no-build
# 库名 MUST 带 _test；JWT/内部密钥 MUST 与 .env.prod 不同
# =============================================================================

# --- 镜像 ---
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/pangbao-test
IMAGE_TAG=v2.0.1-beta.1
# CI push 登录凭证（GitHub Actions 读本文件；与服务器 pull 共用同一 ACR 实例）
# push 地址由 workflow 从 REGISTRY 去掉 -vpc 自动推导，无需单独配置
ACR_USERNAME=8区投投
ACR_PASSWORD=Fang930927

# --- MySQL ---
MYSQL_TCP_HOST=120.55.50.105
HISTORY_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_history_test
DEVICE_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_device_test
VOICE_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_voice_test
WORKER_OUTBOX_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_worker_test
APP_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_app_test
UCG_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_ucg_test

# --- Redis（测试 standalone；须先 up redis-standalone.test.yml）---
GF_REDIS_DEFAULT_ADDRESS=redis-test:6379
GF_REDIS_DEFAULT_DB=0

# --- 密钥与对外地址 ---
GATEWAY_APP_JWT_SECRET=pangbao-jwt-test-change-me-to-random-64chars
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-test-me
GATEWAY_APP_PUBLIC_BASE_URL=https://test.pangbao.cuplay.top
GATEWAY_APP_VERSION_ADMIN_PASSWORD=a521521521
