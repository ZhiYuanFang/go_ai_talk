# =============================================================================
# 测试 Compose 环境变量（勿提交 git）
#
# 启动（须先起 test Redis / RabbitMQ，见 runbook）：
#   COMPOSE_PROJECT_NAME=go-ai-talk-test \
#   docker compose --env-file manifest/docker/.env.test \
#     -f manifest/docker/docker-compose.microservices.yml \
#     -f manifest/docker/docker-compose.microservices.test.yml \
#     pull && up -d --no-build
#
# 默认 IMAGE_TAG=develop（push develop 分支后 GitHub Actions 自动构建）。
# 排错时可临时改为 Actions 日志中的 git sha tag（如 abc1234）。
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像仓库（必填）
# -----------------------------------------------------------------------------

# ACR 测试命名空间 = <实例域名>/<测试命名空间>（与 GitHub Secret ACR_REGISTRY_TEST 命名空间一致）。
# 去哪找：ACR 控制台 → 命名空间 → 测试用命名空间（须与生产命名空间不同）。
# ECS pull 可用 -vpc 域名；GitHub push develop 时用公网域名 + 同一测试命名空间。
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/pangbao-test

# 测试环境跟踪 develop 分支浮动 tag；CI push develop 后 Actions 推送 :develop 与 :<sha>。
IMAGE_TAG=develop

# -----------------------------------------------------------------------------
# MySQL 连接串（必填，6 条 — MUST 指向 *_test 库，禁止连生产库）
# 格式：mysql:<用户名>:<密码>@tcp(<主机>:3306)/<库名>
# 去哪找：
#   - 账号/密码：可与生产同 MySQL 实例，但库名必须带 _test 后缀
#   - 测试库初始化：hack/mask-seed-data.sh 从生产 dump 脱敏导入，或 DBA 手工建库
# -----------------------------------------------------------------------------

# history-service → 库 ai_voice_history_test
HISTORY_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_history_test

# device-service → 库 ai_voice_device_test
DEVICE_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_device_test

# voice-service → 库 ai_voice_voice_test
VOICE_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_voice_test

# worker-service → 库 ai_voice_worker_test
WORKER_OUTBOX_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_worker_test

# gateway-app → 库 ai_voice_app_test
APP_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_app_test

# ucg-service → 库 ai_voice_ucg_test
UCG_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_ucg_test

# -----------------------------------------------------------------------------
# Redis Cluster（必填 — 测试栈专用）
# -----------------------------------------------------------------------------

# GoFrame redis.default.address；测试 overlay 注入各微服务。
# 去哪找：docker-compose.redis-cluster.test.yml 启动后，容器网络内三主节点种子地址（固定值，一般无需改）。
# 宿主机映射端口为 17001–17006，与生产 Redis 7001–7006 物理隔离。
GF_REDIS_DEFAULT_ADDRESS=redis-node-1:7001,redis-node-2:7002,redis-node-3:7003

# -----------------------------------------------------------------------------
# 对外地址与密钥（必填）
# -----------------------------------------------------------------------------

# 测试 App 网关对外 HTTPS 基址（无末尾斜杠）。
# 去哪找：Nginx 反代 test.pangbao.cuplay.top:9702 → 宿主机 19702。
GATEWAY_APP_PUBLIC_BASE_URL=https://test.pangbao.cuplay.top:9702

# 测试环境内部 API 密钥；MUST 与生产 DEVICE_GATEWAY_INTERNAL_SECRET 不同。
# 去哪找：自行生成；gateway-app / device-service / ucg-service 三处须一致。
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-test-me

# 测试环境版本管理页口令（可与生产不同，便于测试上传 APK）。
GATEWAY_APP_VERSION_ADMIN_PASSWORD=a521521521
