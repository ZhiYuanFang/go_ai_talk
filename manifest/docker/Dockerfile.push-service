FROM m.daocloud.io/docker.io/library/golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/push-service ./cmd/push-service

FROM m.daocloud.io/docker.io/library/alpine:3.19

RUN apk add --no-cache ca-certificates wget tzdata
ENV TZ=Asia/Shanghai

ENV WORKDIR=/app
ENV GF_GCFG_FILE=manifest/config/config.push-service.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/push-service ${WORKDIR}/push-service
COPY manifest/config/config.push-service.yaml ${WORKDIR}/manifest/config/config.push-service.yaml

EXPOSE 9808
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9808/api.json > /dev/null || exit 1
CMD ["./push-service"]
