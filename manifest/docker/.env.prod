# =============================================================================
# 生产环境（project=go-ai-talk-prod）
# 启动：docker compose --env-file manifest/docker/.env.prod \
#   -f manifest/docker/docker-compose.microservices.yml \
#   -f manifest/docker/docker-compose.microservices.prod.yml \
#   -f manifest/docker/docker-compose.resources.prod.yml \
#   pull && up -d --no-build
# IMAGE_TAG 须与 git 正式 tag 一致（如 v1.0.0）
# =============================================================================

# --- 镜像 ---
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/pangbao-release
IMAGE_TAG=v2.0.1

# --- MySQL（改地址只改 MYSQL_TCP_HOST；DSN 中 mysql-host 由 dbcfg 替换）---
MYSQL_TCP_HOST=120.55.50.105
HISTORY_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_history
DEVICE_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_device
VOICE_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_voice
WORKER_OUTBOX_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_worker
APP_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_app
UCG_DB_LINK=mysql:root:Fang930927@tcp(mysql-host:3306)/ai_voice_ucg

# --- Redis（生产 3 主 Cluster；多地址逗号分隔，rediscfg 自动走 Cluster 客户端）---
GF_REDIS_DEFAULT_ADDRESS=redis-node-1:7001,redis-node-2:7002,redis-node-3:7003
GF_REDIS_DEFAULT_DB=0

# --- 密钥与对外地址（prod/test MUST 不同值）---
GATEWAY_APP_JWT_SECRET=pangbao-jwt-prod-change-me-to-random-64chars
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-release-me
GATEWAY_APP_PUBLIC_BASE_URL=https://www.pangbao.cuplay.top
GATEWAY_APP_VERSION_ADMIN_PASSWORD=a521521521
