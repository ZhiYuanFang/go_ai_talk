# =============================================================================
# 生产 Compose 环境变量（勿提交 git）
#
# 启动：
#   docker compose --env-file manifest/docker/.env.prod \
#     -f manifest/docker/docker-compose.microservices.yml \
#     -f manifest/docker/docker-compose.microservices.prod.yml \
#     pull && up -d --no-build
#
# 发版：将 IMAGE_TAG 改为与 git tag / GitHub Actions 构建一致的 semver（如 v1.0.0）。
# 禁止 develop / latest / local。
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像仓库（必填）
# -----------------------------------------------------------------------------

# 阿里云 ACR 实例地址（不含 https://、不含仓库名后缀）。
# 去哪找：阿里云控制台 → 容器镜像服务 ACR → 实例概览 → 公网/VPC 域名；
#         须与 GitHub 仓库 Secrets 中的 ACR_REGISTRY 完全一致。
# 镜像拉取格式：${REGISTRY}/gateway:${IMAGE_TAG}（服务名 gateway、gateway-app、history-service 等）
REGISTRY=crpi-lff3xynwzvqxxxjk.cn-hangzhou.personal.cr.aliyuncs.com

# 当前生产版本 tag（semver，与 git tag 一致，如 v1.0.0）。
# 去哪找：GitHub Actions 构建成功后，在 ACR 镜像仓库看到的 tag；或本次发布的 git tag 名。
# 每次生产发版前改此值，然后 pull + up --no-build。
IMAGE_TAG=v1.0.0

# -----------------------------------------------------------------------------
# MySQL 连接串（必填，6 条）
# 格式：mysql:<用户名>:<密码>@tcp(<主机>:3306)/<库名>
# 去哪找：
#   - 用户名/密码：RDS 控制台「账号管理」，或服务器 MySQL 自建账号
#   - 主机：MySQL 与 Docker 同机 → host.docker.internal；RDS → 内网地址（如 rm-xxx.mysql.rds.aliyuncs.com）
#   - 库名：生产库无 _test 后缀；首次部署需 DBA 建库并跑迁移
# 注意：DSN 含多个冒号，compose 已加引号；password 含特殊字符时需 URL 编码。
# -----------------------------------------------------------------------------

# history-service 会话/历史域 → 库 ai_voice_history
HISTORY_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_history

# device-service 设备/用户/wx 域 → 库 ai_voice_device
DEVICE_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_device

# voice-service 语音/QA 域 → 库 ai_voice_voice
VOICE_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_voice

# worker-service outbox  relay 专用 → 库 ai_voice_worker（仅 domain_outbox 等 worker 表）
WORKER_OUTBOX_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_worker

# gateway-app 版本检查/ai_voice_app → 库 ai_voice_app
APP_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_app

# ucg-service 社交 UGC 域 → 库 ai_voice_ucg
UCG_DB_LINK=mysql:root:Fang930927@tcp(host.docker.internal:3306)/ai_voice_ucg

# -----------------------------------------------------------------------------
# 密钥与对外地址（必填，3 项）
# -----------------------------------------------------------------------------

# gateway-app / device-service / ucg-service 三处 MUST 相同。
# 用途：gateway-app 调 device 内部 API、ucg 调 device 内部 API 时 HTTP 头 X-Device-Gateway-Internal-Secret 校验。
# 去哪找：自行生成随机串（≥32 字符），勿与测试环境 DEVICE_GATEWAY_INTERNAL_SECRET 相同。
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-release-me

# gateway-app 对外 HTTPS 根地址（无末尾斜杠）。
# 用途：拼接 APK 绝对下载 URL、微信 Universal Links 相关链接。
# 去哪找：Nginx 反代配置 — 生产 App 网关入口，如 https://www.pangbao.cuplay.top:9702
GATEWAY_APP_PUBLIC_BASE_URL=https://www.pangbao.cuplay.top:9702

# gateway-app 版本管理页（/gateway-app-version-admin.html）登录口令。
# 用途：上传 APK、维护 version 表 download_url。
# 去哪找：自行设定强口令；与设备管理后台口令无关。
GATEWAY_APP_VERSION_ADMIN_PASSWORD=a521521521
