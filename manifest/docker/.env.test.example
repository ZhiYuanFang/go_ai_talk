# =============================================================================
# 测试 Compose 环境变量示例（复制为 manifest/docker/.env.test，勿提交 git）
#
# 启动（project=go-ai-talk-test，须叠加 microservices.test.yml + resources.test.yml）：
#   docker compose --env-file manifest/docker/.env.test \
#     -f manifest/docker/docker-compose.microservices.yml \
#     -f manifest/docker/docker-compose.microservices.test.yml \
#     -f manifest/docker/docker-compose.resources.test.yml \
#     pull && up -d --no-build
#
# 镜像由 git 预发布 tag 触发 CI 构建（develop push 不构建）：
#   git tag v1.0.0-rc.1 && git push origin v1.0.0-rc.1
# GitHub Secrets：ACR_REGISTRY_TEST（公网域名/测试命名空间）、ACR_USERNAME、ACR_PASSWORD。
# =============================================================================

# 测试 ACR：<域名>/<测试命名空间>；须与 .env.prod 的生产命名空间不同
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/<测试命名空间>
# 与最近一次 push 的预发布 git tag 一致（vMAJOR.MINOR.PATCH-xxx，非 develop）
IMAGE_TAG=v1.0.0-rc.1

# --- MySQL（测试库 ai_voice_*_test，MUST NOT 指向生产库）---
# 各 *_DB_LINK 由 cmd 启动时 gdb.SetConfigGroup 覆盖 yaml（internal/platform/dbcfg）；须使用含该逻辑的镜像。
HISTORY_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_history_test
DEVICE_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_device_test
VOICE_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_voice_test
WORKER_OUTBOX_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_worker_test
APP_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_app_test
UCG_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_ucg_test

# --- Redis（测试 standalone）---
# 须先启动 docker-compose.redis-standalone.test.yml；覆盖 yaml 中的 cluster 地址
GF_REDIS_DEFAULT_ADDRESS=redis-test:6379

# --- gateway-app 对外基址（仅 APK 绝对下载 URL 用；在服务器 .env.test 填写，勿写入 compose）---
# 填宝塔 Nginx 反代后的 HTTPS 根地址（无末尾斜杠）；其 hostname 亦用于 gateway-app CORS 白名单。
GATEWAY_APP_PUBLIC_BASE_URL=https://你的测试域名

# --- 可选：额外 CORS 允许的主机名（逗号分隔，不含 scheme/端口）---
# GATEWAY_APP_CORS_ALLOWED_HOSTS=

# --- 测试密钥（须与生产不同）---
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-test-change-me
GATEWAY_APP_VERSION_ADMIN_PASSWORD=
