FROM m.daocloud.io/docker.io/library/golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/gateway-app-server ./cmd/gateway-app-server

FROM m.daocloud.io/docker.io/library/alpine:3.19

ENV WORKDIR=/app
ENV GF_GCFG_FILE=manifest/config/config.gateway-app-server.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/gateway-app-server ${WORKDIR}/gateway-app-server
COPY api ${WORKDIR}/api
COPY resource ${WORKDIR}/resource
COPY manifest/config/config.gateway-app-server.yaml ${WORKDIR}/manifest/config/config.gateway-app-server.yaml

EXPOSE 9702
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9702/api.json > /dev/null || exit 1
CMD ["./gateway-app-server"]
