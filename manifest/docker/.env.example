# =============================================================================
# Docker Compose 环境变量模板（占位符，不含真实密钥）
# 复制为 .env.local / .env.test / .env.prod 后填入真实值；详见 docs/runbooks/release-deploy-and-run.md
# =============================================================================

# --- 镜像（test/prod 部署）---
REGISTRY=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/your-namespace
IMAGE_TAG=v0.0.0
ACR_USERNAME=
ACR_PASSWORD=

# --- MySQL ---
MYSQL_TCP_HOST=mysql-host-ip
HISTORY_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_history
DEVICE_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_device
VOICE_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_voice
APP_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_app
UCG_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_ucg
# 全局推送库（push-service）；同实例独立 schema
PUSH_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_push
# sim-user-service 自有表（可与 APP 库同实例不同库，或复用 APP 库）
SIM_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_sim
# cash-service（VIP + 商业功能开通）
CASH_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_cash
CASH_SERVICE_URL=http://cash-service:9807
CASH_SERVICE_ADDR=:9807
# UCG 入场资格：cash → history 内部按日统计（勿给 cash 配 history DB）
HISTORY_SERVICE_URL=http://history-service:9801
# 支付宝 / Apple IAP（密钥勿提交真实值）
CASH_ALIPAY_APP_ID=
CASH_ALIPAY_PRIVATE_KEY=
CASH_ALIPAY_PUBLIC_KEY=
CASH_ALIPAY_NOTIFY_URL=
CASH_APPLE_BUNDLE_ID=
# Apple Server Notifications V2 URL 配在 App Store Connect（Production + Sandbox），非本 env：
#   https://<gateway>/cash/app/api/vip/apple/notifications
# 可选：覆盖内置 Apple Root CA - G3 PEM（证书轮换时）；默认无需配置
# CASH_APPLE_ROOT_CA_PEM=
# 仅非生产：跳过渠道验签（仍校验订单/商品）；ASN 路径始终验签，不受此开关影响
CASH_PAYMENT_DEV_BYPASS=
# 可选：cash Admin API 下游口令；空则 gateway / cash-service 回退 GATEWAY_APP_ADMIN_PASSWORD
# Hub：「开通功能管理」（含 VIP 套餐 / VIP列表）/「邀请码管理」
CASH_ADMIN_PASSWORD=

# --- sim-user-service ---
# 进程总闸（false 时 scheduler 不启动，须 force-recreate）；任务/周期/LLM lane 默认在 sim DB 种子，经 Admin 在线改
SIM_USER_SERVICE_ENABLED=false
SIM_ADMIN_PASSWORD=
# 迁移期可选：首次 EnsureSchema 前若需用 env 覆盖种子，可临时保留 SIM_LLM_* / SIM_TASK_*（Admin 保存后以 DB 为准）
# 管理页：/device/admin/sim-admin.html（运行配置）、/device/admin/ai-model-admin.html（LLM lane）
GF_REDIS_DEFAULT_ADDRESS=redis-node-1:7001,redis-node-2:7002,redis-node-3:7003
GF_REDIS_DEFAULT_DB=0
# --- 日志级别（经各服务 loggercfg.ApplyFromEnv 生效；GoFrame 不会自动覆盖 yaml）---
# GF_LOGGER_LEVEL 取值（改后须 docker compose up -d --force-recreate 相关服务）：
#   留空           → 不覆盖，沿用各服务 yaml 的 logger.level（当前多为 all，含 DEBU/INFO）
#   prod / product → 仅 WARN / ERRO / CRIT（抑制 Info/Debug，含 cachekit）
#   info           → INFO 及以上（无 DEBU）
#   all / dev / debug → 含 DEBU 的全量
#   其它非法值     → 启动打 Error，级别保持 yaml
# 生产建议 prod；临时排障可改为 all 或 info，看完改回。
GF_LOGGER_LEVEL=prod

# --- 密钥与对外地址 ---
GATEWAY_APP_JWT_SECRET=change-me-random-64chars
# notify-service：独立域名（示例 status.pangbao.cuplay.top），Hub 外链见 admin-modules.js
NOTIFY_ADMIN_PUBLIC_URL=https://status.pangbao.cuplay.top/admin
NOTIFY_SERVICE_ADDR=:9806
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-change-me
GATEWAY_APP_PUBLIC_BASE_URL=https://example.com
# 运维 Hub 登录（App 网关 :9702 唯一管理入口）；下游 device/ucg 口令由 gateway-app 注入
GATEWAY_APP_ADMIN_USERNAME=admin
GATEWAY_APP_ADMIN_PASSWORD=
DEVICE_ADMIN_PASSWORD=
UCG_ADMIN_PASSWORD=
VOICE_ADMIN_PASSWORD=

# voice-service HTTP 反代（gateway-app / gateway-service；与 VOICE_WS_PROXY_URL 通常同 host:9802）
VOICE_API_PROXY_URL=http://voice-service:9802
VOICE_API_ROUTE_MODE=proxy

# --- ucg-service 阿里云（OSS 服务端上传 / Green 审核共用 AccessKey；DashScope AI 润笔）---
# config.ucg-service.yaml：bucket=caidoukeji、region=cn-hangzhou、默认内网 endpoint；accessKey* / dashscope_api_key MUST 留空，由 Compose 注入。
# 客户端一律 POST /media/upload（预签名直传已停用）。旧桶 pang-bao 弃用；运维须同 objectKey 拷贝至 caidoukeji，CDN 已指向新桶。
# 可选：本地非 VPC 联调覆盖公网 endpoint，例 UCG_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com（生产勿设，用 yaml 内网）。
UCG_OSS_ACCESS_KEY_ID=
UCG_OSS_ACCESS_KEY_SECRET=
# UCG_OSS_ENDPOINT=
UCG_DASHSCOPE_API_KEY=
# voice-service 对话 STT（百炼 qwen-audio-3.0-asr-flash-streaming）；空则回退 UCG_DASHSCOPE_API_KEY
VOICE_DASHSCOPE_API_KEY=
# 百炼业务空间 ID，用于 wss://{id}.cn-beijing.maas.aliyuncs.com/... ；对话 /voice/chat/ws 必填
DASHSCOPE_WORKSPACE_ID=

# =============================================================================
# AI 模型：API 密钥 + 可选 provider/model 冷启动种子
# - maxInFlight / maxWaiters / timeout：仅经 /device/admin/ai-model-admin.html 配置（DB）
# - 下方 PROVIDER/MODEL 仅影响 EnsureDefaultRows 种子行（updated_by=seed）；Admin 保存后以 DB 为准
# =============================================================================
GLM_API_KEY=
DEEPSEEK_API_KEY=

# voice-service（llm_lane_config 种子，可选）
VOICE_LLM_VOICE_UNDERSTANDING_PROVIDER=deepseek
VOICE_LLM_VOICE_UNDERSTANDING_MODEL=deepseek-v4-flash
VOICE_LLM_CLINIC_PROVIDER=deepseek
VOICE_LLM_CLINIC_MODEL=deepseek-v4-pro

# voice 预测临近离线推送：相对 nextAt 提前多少秒发延时叫醒（默认 300=5 分钟）
VOICE_PREDICT_IMMINENT_LEAD_SECONDS=300

# ucg-service 润笔（ucg_ai_config 种子，可选）
UCG_AI_PROVIDER=dashscope
UCG_AI_VISION_MODEL=qwen3-vl-plus

# sim：见 sim-admin / ai-model-admin；勿再配 SIM_LLM_* / SIM_TASK_*

# --- push-service 系统推送（APNs / 华为 HMS / 小米 MiPush）---
# config.push-service.yaml 中 push.* MUST 留空，由 Compose 注入 push-service 容器 env。
# 未配置某厂商时，对应 channel 推送跳过（日志 Debug），不影响主业务。
# APNs .p8 须挂载进容器；PUSH_APNS_KEY_PATH 为容器内绝对路径（代码读文件，不支持 env 内嵌密钥正文）。
# PUSH_APNS_PRODUCTION：true 或 1 时使用 production APNs（api.push.apple.com）；否则 sandbox。
# App 注册：POST /app/api/push/register（经 gateway-app）；旧 /ucg/app/api/push/* 已删除（BREAKING）。
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
PUSH_APNS_BUNDLE_ID=
PUSH_APNS_KEY_PATH=
PUSH_APNS_PRODUCTION=
# 华为 Push Kit：AppGallery Connect → 应用 → 常规 → 应用 ID / Client Secret
PUSH_HMS_APP_ID=
PUSH_HMS_APP_SECRET=
# 可选：点击深链 intent（非空则 click_action type=1+intent；留空默认 type=3 打开应用）
# PUSH_HMS_CLICK_INTENT=
# 小米推送：admin.xmpush.xiaomi.com → 应用信息 AppId / AppKey / AppSecret（与 Flutter push.properties 中客户端 id/key 对应）
PUSH_MIPUSH_APP_ID=
PUSH_MIPUSH_APP_KEY=
PUSH_MIPUSH_APP_SECRET=
PUSH_MIPUSH_PACKAGE_NAME=com.fzy.pangbao

# --- ucg-service RabbitMQ（Publisher HTTP 15672 + Consumer AMQP 5672）---
# MQ_HTTP_API_BASE=http://rabbitmq:15672/api
# RABBITMQ_AMQP_URL=amqp://guest:guest@rabbitmq:5672/
# UCG_AUDIT_MQ_CONSUMER_ENABLED=true
# UCG_AUDIT_MQ_PREFETCH=5
# UCG_RECOMMEND_MQ_CONSUMER_ENABLED=true
# 热区 reconciler tick 间隔（秒）；默认 yaml 3600；冷区互动翻红依赖 consumer 开启
# UCG_RECOMMEND_HOT_SCAN_INTERVAL_SECONDS=3600

# --- mcp-service（小智 MCP 接入服务）---
# mcp-service 不连 MySQL/Redis、不监听 HTTP 端口；仅作为 WebSocket 客户端拨号连接小智接入点。
# 经 HTTP 委派 voice-service 文本对话，须与 history/voice 共用 DEVICE_GATEWAY_INTERNAL_SECRET。
# TOKEN / DEVICE_NO 缺失时进程 fail-fast 退出；从 xiaozhi.me 控制台智能体配置页获取。
XIAOZHI_MCP_TOKEN=
XIAOZHI_MCP_DEVICE_NO=
# 可选：接入点基址（默认 wss://api.xiaozhi.me/mcp/）与重连退避（默认 2000/60000 毫秒）
# XIAOZHI_MCP_BASE_URL=wss://api.xiaozhi.me/mcp/
# XIAOZHI_MCP_RECONNECT_MIN_MS=2000
# XIAOZHI_MCP_RECONNECT_MAX_MS=60000
