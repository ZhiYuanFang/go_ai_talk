# =============================================================================
# Docker Compose 环境变量模板（占位符，不含真实密钥）
# 复制为 .env.local / .env.test / .env.prod 后填入真实值；详见 docs/runbooks/release-deploy-and-run.md
# =============================================================================

# --- 镜像（test/prod 部署）---
REGISTRY=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/your-namespace
IMAGE_TAG=v0.0.0
ACR_USERNAME=
ACR_PASSWORD=

# --- MySQL ---
MYSQL_TCP_HOST=mysql-host-ip
HISTORY_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_history
DEVICE_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_device
VOICE_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_voice
APP_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_app
UCG_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_ucg
# sim-user-service 自有表（可与 APP 库同实例不同库，或复用 APP 库）
SIM_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/ai_voice_sim

# --- sim-user-service ---
SIM_USER_SERVICE_ENABLED=false
SIM_ADMIN_PASSWORD=
# 各任务独立开关（默认 true）；长期运营可先关 video/chat 减轻 MySQL 压力
# SIM_TASK_REGISTER_ENABLED=true
# SIM_TASK_COMMENT_ENABLED=true
# SIM_TASK_POST_IMAGE_ENABLED=true
# SIM_TASK_POST_VIDEO_ENABLED=false
# SIM_TASK_CHAT_ENABLED=false
# SIM_TASK_FOLLOW_ENABLED=true
# SIM_VIDEO_POLL_ENABLED=false
# 任务周期（Go duration；未设置时与代码默认一致）
# SIM_INTERVAL_REGISTER=24h
# SIM_INTERVAL_COMMENT=6h
# SIM_INTERVAL_POST_IMAGE=3h30m
# SIM_INTERVAL_POST_VIDEO=6h30m
# SIM_INTERVAL_CHAT=1h
# SIM_INTERVAL_FOLLOW=7h
# P1 自适应：无 pending job 用 idle，有 pending 用 active
# SIM_INTERVAL_VIDEO_POLL_IDLE=10m
# SIM_INTERVAL_VIDEO_POLL_ACTIVE=2m
# E1 真人聊天临时窗口（默认 loop=5m window=15m）
# SIM_EPHEMERAL_CHAT_LOOP=5m
# SIM_EPHEMERAL_CHAT_WINDOW=15m
# 启动后各任务首次 tick 随机延迟上限（默认 30m，避免齐射）
# SIM_STARTUP_STAGGER_MAX=30m
# 经 gateway-app 的出站 HTTP 全局限速（token bucket）
# SIM_UCG_RATE_LIMIT_RPS=2
# SIM_UCG_RATE_LIMIT_BURST=4
GF_REDIS_DEFAULT_ADDRESS=redis-node-1:7001,redis-node-2:7002,redis-node-3:7003
GF_REDIS_DEFAULT_DB=0

# --- 密钥与对外地址 ---
GATEWAY_APP_JWT_SECRET=change-me-random-64chars
DEVICE_GATEWAY_INTERNAL_SECRET=gateway-internal-change-me
GATEWAY_APP_PUBLIC_BASE_URL=https://example.com
# 运维 Hub 登录（App 网关 :9702 唯一管理入口）；下游 device/ucg 口令由 gateway-app 注入
GATEWAY_APP_ADMIN_USERNAME=admin
GATEWAY_APP_ADMIN_PASSWORD=
DEVICE_ADMIN_PASSWORD=
UCG_ADMIN_PASSWORD=
VOICE_ADMIN_PASSWORD=

# voice-service HTTP 反代（gateway-app / gateway-service；与 VOICE_WS_PROXY_URL 通常同 host:9802）
VOICE_API_PROXY_URL=http://voice-service:9802
VOICE_API_ROUTE_MODE=proxy

# --- ucg-service 阿里云（OSS 直传 / Green 审核共用 AccessKey；DashScope AI 润笔）---
# config.ucg-service.yaml 中 ucg.oss.accessKey* 与 ucg.ai.dashscope_api_key MUST 留空，由 Compose 注入容器 env。
UCG_OSS_ACCESS_KEY_ID=
UCG_OSS_ACCESS_KEY_SECRET=
UCG_DASHSCOPE_API_KEY=

# =============================================================================
# AI 模型：API 密钥 + 各服务 lane 冷启动默认（策略 B）
# - Admin 已改过的 DB 配置（updated_by≠seed）优先，env 不覆盖
# - 种子行 / 无行 / sim 无 DB：以本段为准
# - 修改后须 force-recreate 对应服务（voice / ucg / sim）
# =============================================================================
GLM_API_KEY=
DEEPSEEK_API_KEY=

# voice-service（llm_lane_config 种子）
VOICE_LLM_VOICE_UNDERSTANDING_PROVIDER=deepseek
VOICE_LLM_VOICE_UNDERSTANDING_MODEL=deepseek-chat
VOICE_LLM_VOICE_UNDERSTANDING_MAX_INFLIGHT=1
VOICE_LLM_VOICE_UNDERSTANDING_MAX_WAITERS=20
VOICE_LLM_VOICE_UNDERSTANDING_TIMEOUT_SEC=20
VOICE_LLM_CLINIC_PROVIDER=deepseek
VOICE_LLM_CLINIC_MODEL=deepseek-v4-pro
VOICE_LLM_CLINIC_MAX_INFLIGHT=1
VOICE_LLM_CLINIC_MAX_WAITERS=10
VOICE_LLM_CLINIC_TIMEOUT_SEC=120

# ucg-service 润笔（ucg_ai_config 种子）
UCG_AI_PROVIDER=dashscope
UCG_AI_VISION_MODEL=qwen3-vl-plus
UCG_AI_MAX_INFLIGHT=1
UCG_AI_MAX_WAITERS=15
UCG_AI_TIMEOUT_SEC=60

# sim-user-service（无 DB/Admin，env 始终生效）
SIM_LLM_SIMTEXT_PROVIDER=deepseek
SIM_LLM_SIMTEXT_MODEL=deepseek-chat
SIM_LLM_SIMTEXT_MAX_INFLIGHT=1
SIM_LLM_SIMTEXT_MAX_WAITERS=20
SIM_LLM_SIMTEXT_TIMEOUT_SEC=60
SIM_LLM_SIMVISION_PROVIDER=zhipu
SIM_LLM_SIMVISION_MODEL=GLM-4.6V-Flash
SIM_LLM_SIMVISION_MAX_INFLIGHT=1
SIM_LLM_SIMVISION_MAX_WAITERS=15
SIM_LLM_SIMVISION_TIMEOUT_SEC=60
SIM_LLM_SIMIMAGEGEN_PROVIDER=zhipu
SIM_LLM_SIMIMAGEGEN_MODEL=cogview-3-flash
SIM_LLM_SIMIMAGEGEN_MAX_INFLIGHT=1
SIM_LLM_SIMIMAGEGEN_MAX_WAITERS=10
SIM_LLM_SIMIMAGEGEN_TIMEOUT_SEC=120
SIM_LLM_SIMVIDEOGEN_PROVIDER=zhipu
SIM_LLM_SIMVIDEOGEN_MODEL=cogvideox-flash
SIM_LLM_SIMVIDEOGEN_MAX_INFLIGHT=1
SIM_LLM_SIMVIDEOGEN_MAX_WAITERS=5
SIM_LLM_SIMVIDEOGEN_TIMEOUT_SEC=300

# --- ucg-service 启动器角标推送（APNs / 华为 HMS / 小米 MiPush）---
# config.ucg-service.yaml 中 ucg.push.* MUST 留空，由 Compose 注入 ucg-service 容器 env。
# 未配置某厂商时，对应 channel 推送跳过（日志 Debug），不影响主业务。
# APNs .p8 须挂载进容器；UCG_APNS_KEY_PATH 为容器内绝对路径（代码读文件，不支持 env 内嵌密钥正文）。
# UCG_APNS_PRODUCTION：true 或 1 时使用 production APNs（api.push.apple.com）；否则 sandbox。
UCG_APNS_KEY_ID=
UCG_APNS_TEAM_ID=
UCG_APNS_BUNDLE_ID=
UCG_APNS_KEY_PATH=
UCG_APNS_PRODUCTION=
# 华为 Push Kit：AppGallery Connect → 应用 → 常规 → 应用 ID / Client Secret
UCG_HMS_APP_ID=
UCG_HMS_APP_SECRET=
# 小米推送：admin.xmpush.xiaomi.com → 应用信息 AppId / AppKey / AppSecret（与 Flutter push.properties 中客户端 id/key 对应）
UCG_MIPUSH_APP_ID=
UCG_MIPUSH_APP_KEY=
UCG_MIPUSH_APP_SECRET=

# --- ucg-service RabbitMQ（Publisher HTTP 15672 + Consumer AMQP 5672）---
# MQ_HTTP_API_BASE=http://rabbitmq:15672/api
# RABBITMQ_AMQP_URL=amqp://guest:guest@rabbitmq:5672/
# UCG_AUDIT_MQ_CONSUMER_ENABLED=true
# UCG_AUDIT_MQ_PREFETCH=5
# UCG_RECOMMEND_MQ_CONSUMER_ENABLED=true
# 热区 reconciler tick 间隔（秒）；默认 yaml 3600；冷区互动翻红依赖 consumer 开启
# UCG_RECOMMEND_HOT_SCAN_INTERVAL_SECONDS=3600

# 各任务独立开关（代码默认均为 true）
SIM_TASK_REGISTER_ENABLED=true
SIM_TASK_COMMENT_ENABLED=true
SIM_TASK_POST_IMAGE_ENABLED=true
SIM_TASK_POST_VIDEO_ENABLED=true
SIM_TASK_CHAT_ENABLED=true
SIM_TASK_FOLLOW_ENABLED=true
SIM_VIDEO_POLL_ENABLED=true
# 任务周期（Go duration；与 runtime.go 默认一致）
SIM_INTERVAL_REGISTER=24h
SIM_INTERVAL_COMMENT=6h
SIM_INTERVAL_POST_IMAGE=3h30m
SIM_INTERVAL_POST_VIDEO=6h30m
SIM_INTERVAL_CHAT=1h
SIM_INTERVAL_FOLLOW=7h
# P1 自适应：无 pending video job 用 idle，有 pending 用 active
SIM_INTERVAL_VIDEO_POLL_IDLE=10m
SIM_INTERVAL_VIDEO_POLL_ACTIVE=2m
# E1 真人聊天临时窗口
SIM_EPHEMERAL_CHAT_LOOP=5m
SIM_EPHEMERAL_CHAT_WINDOW=15m
# 启动后各任务首次 tick 前随机延迟上限（默认 30m，避免齐射）
SIM_STARTUP_STAGGER_MAX=30m
# 经 gateway-app 的出站 HTTP 全局限速（修改后须 force-recreate sim-user-service）
SIM_UCG_RATE_LIMIT_RPS=2
SIM_UCG_RATE_LIMIT_BURST=4