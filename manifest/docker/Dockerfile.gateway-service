FROM golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/gateway-service .

FROM alpine:3.19

ENV WORKDIR=/app
ENV GF_GCFG_FILE=manifest/config/config.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/gateway-service ${WORKDIR}/gateway-service
COPY resource ${WORKDIR}/resource
COPY manifest/config/config.yaml ${WORKDIR}/manifest/config/config.yaml

EXPOSE 9701
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9701/api.json > /dev/null || exit 1
CMD ["./gateway-service"]
