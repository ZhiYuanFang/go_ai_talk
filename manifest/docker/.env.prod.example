# =============================================================================
# 生产 Compose 环境变量示例（复制为 manifest/docker/.env.prod，勿提交 git）
#
# 启动：
#   docker compose --env-file manifest/docker/.env.prod \
#     -f manifest/docker/docker-compose.microservices.yml \
#     -f manifest/docker/docker-compose.microservices.prod.yml \
#     pull && up -d --no-build
#
# 发版时修改 IMAGE_TAG 为与 git tag / GitHub Actions 构建一致的 semver（如 v1.0.0）。
# GitHub Secrets：ACR_REGISTRY_PROD（公网域名/生产命名空间）、ACR_USERNAME、ACR_PASSWORD。
# =============================================================================

# 生产 ACR：<域名>/<生产命名空间>；ECS 可用 -vpc 域名
REGISTRY=crpi-lff3xynwzvqxxxjk-vpc.cn-hangzhou.personal.cr.aliyuncs.com/<生产命名空间>
IMAGE_TAG=v1.0.0

# --- MySQL（生产库名，无 _test 后缀）---
HISTORY_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_history
DEVICE_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_device
VOICE_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_voice
WORKER_OUTBOX_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_worker
APP_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_app
UCG_DB_LINK=mysql:user:password@tcp(host.docker.internal:3306)/ai_voice_ucg

# --- 生产密钥（勿提交 git）---
DEVICE_GATEWAY_INTERNAL_SECRET=
GATEWAY_APP_PUBLIC_BASE_URL=https://www.pangbao.cuplay.top:9702
GATEWAY_APP_VERSION_ADMIN_PASSWORD=
