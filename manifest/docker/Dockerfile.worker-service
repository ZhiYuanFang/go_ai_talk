FROM golang:1.23-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/worker-service ./cmd/worker-service

FROM alpine:3.19

ENV WORKDIR=/app
ENV WORKER_HEALTH_ADDR=:9901
ENV GF_GCFG_FILE=manifest/config/config.worker-service.yaml
WORKDIR ${WORKDIR}

COPY --from=builder /out/worker-service ${WORKDIR}/worker-service
COPY manifest/config/config.worker-service.yaml ${WORKDIR}/manifest/config/config.worker-service.yaml

EXPOSE 9901
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD wget -q -O - http://127.0.0.1:9901/healthz > /dev/null || exit 1
CMD ["./worker-service"]
